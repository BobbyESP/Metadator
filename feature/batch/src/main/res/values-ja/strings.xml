    <string name="batch_pattern_description">{title}、{artist}、{album}、{albumartist}、{track}、{disc}、{year}、{genre} を使用できます</string>
    <string name="batch_pattern_field">パターン</string>
    <string name="batch_pattern_invalid">各プレースホルダーは 1 回まで、少なくとも 1 つ使用してください</string>
    <string name="batch_pattern_no_match">一致しません</string>

