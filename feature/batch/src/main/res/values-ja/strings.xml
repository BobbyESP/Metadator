    <string name="batch_cover_set">全曲に同じカバー画像を使用</string>
    <string name="batch_cover_remove">すべてのカバー画像を削除</string>
    <string name="batch_cover_keep">各曲のカバー画像を維持</string>
    <string name="batch_cover_will_replace">すべての曲にこのカバー画像が設定されます</string>
    <string name="batch_cover_will_remove">すべての曲のカバー画像が削除されます</string>

    <!-- Tools -->
    <string name="batch_tools">ツール</string>
    <string name="batch_numbering">トラックに番号を付ける</string>
    <string name="batch_numbering_description">表示順に、トラック N / %1$d として設定</string>
    <string name="batch_numbering_start">開始番号</string>
