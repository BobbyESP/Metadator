    <string name="batch_apply">すべてに適用</string>
    <string name="batch_access_denied">Metadator にこれらのファイルの変更が許可されませんでした</string>
    <string name="batch_running">%2$d 件中 %1$d 件を保存中</string>
    <string name="batch_cancel">停止</string>

