    <string name="batch_pattern_description">Verwende {title}, {artist}, {album}, {albumartist}, {track}, {disc}, {year} und {genre}</string>
    <string name="batch_pattern_field">Muster</string>
    <string name="batch_pattern_invalid">Verwende jeden Platzhalter höchstens einmal und mindestens einen</string>
    <string name="batch_pattern_no_match">Passt nicht</string>

    <!-- Applying -->
    <string name="batch_apply">Auf alle anwenden</string>
    <string name="batch_access_denied">Metadator durfte diese Dateien nicht ändern</string>
    <string name="batch_running">%1$d von %2$d wird gespeichert</string>
    <string name="batch_cancel">Anhalten</string>

    <!-- Result -->
    <string name="batch_done_title">Fertig</string>
    <plurals name="batch_saved">
        <item quantity="one">%1$d Song gespeichert</item>
        <item quantity="other">%1$d Songs gespeichert</item>
    </plurals>
    <plurals name="batch_failed">
        <item quantity="one">%1$d Song konnte nicht gespeichert werden</item>
        <item quantity="other">%1$d Songs konnten nicht gespeichert werden</item>
    </plurals>
    <plurals name="batch_undone">
        <item quantity="one">%1$d Song wiederhergestellt</item>
        <item quantity="other">%1$d Songs wiederhergestellt</item>
    </plurals>
