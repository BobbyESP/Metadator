    <string name="batch_undo_all">Alles rückgängig machen</string>
    <string name="batch_finish">Fertig</string>
    <!-- Why a song couldn't be saved, shown next to its title -->
    <string name="batch_reason_access">nicht erlaubt</string>
    <string name="batch_reason_gone">Datei nicht mehr vorhanden</string>
    <string name="batch_reason_unsupported">Format nicht unterstützt</string>
    <string name="batch_reason_failed">Schreiben fehlgeschlagen</string>
