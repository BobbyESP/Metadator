<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The songs being edited -->
    <plurals name="batch_title">
        <item quantity="one">%1$d Song bearbeiten</item>
        <item quantity="other">%1$d Songs bearbeiten</item>
    </plurals>
    <!-- After the first song titles: "One, Two, Three and 4 more" -->
    <string name="batch_and_more">und %1$d weitere</string>

    <!-- Fields -->
    <string name="batch_fields">Für alle Songs festlegen</string>
    <string name="batch_fields_description">Lass ein Feld unverändert, um den eigenen Wert jedes Songs zu behalten.</string>
    <string name="batch_multiple_values">Mehrere Werte</string>
    <!-- %1$s is the name of a field, such as Album -->
    <string name="batch_reset_field">„%1$s“ jedes Songs beibehalten</string>

    <!-- Cover -->
    <string name="batch_cover_set">Ein Cover für alle verwenden</string>
    <string name="batch_cover_remove">Alle Cover entfernen</string>
    <string name="batch_cover_keep">Cover jedes Songs beibehalten</string>
    <string name="batch_cover_will_replace">Alle Songs erhalten dieses Cover</string>
    <string name="batch_cover_will_remove">Das Cover aller Songs wird entfernt</string>

    <!-- Tools -->
    <string name="batch_tools">Werkzeuge</string>
    <string name="batch_numbering">Titel nummerieren</string>
    <string name="batch_numbering_description">In der angezeigten Reihenfolge, als Titel N von %1$d</string>
    <string name="batch_numbering_start">Beginnen bei</string>
    <string name="batch_pattern">Tags aus Dateinamen lesen</string>
