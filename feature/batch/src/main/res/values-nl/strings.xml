<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The songs being edited -->
    <plurals name="batch_title">
        <item quantity="one">%1$d nummer bewerken</item>
        <item quantity="other">%1$d nummers bewerken</item>
    </plurals>
    <!-- After the first song titles: "One, Two, Three and 4 more" -->
    <string name="batch_and_more">en nog %1$d</string>

    <!-- Fields -->
    <string name="batch_fields">Instellen voor elk nummer</string>
    <string name="batch_fields_description">Laat een veld zoals het is om de eigen waarde van elk nummer te behouden.</string>
    <string name="batch_multiple_values">Meerdere waarden</string>
    <!-- %1$s is the name of a field, such as Album -->
    <string name="batch_reset_field">‘%1$s’ van elk nummer behouden</string>

    <!-- Cover -->
    <string name="batch_cover_set">Eén hoes voor alle gebruiken</string>
    <string name="batch_cover_remove">Alle hoezen verwijderen</string>
    <string name="batch_cover_keep">De hoes van elk nummer behouden</string>
    <string name="batch_cover_will_replace">Elk nummer krijgt deze hoes</string>
    <string name="batch_cover_will_remove">De hoes van elk nummer wordt verwijderd</string>

    <!-- Tools -->
    <string name="batch_tools">Hulpmiddelen</string>
    <string name="batch_numbering">Tracks nummeren</string>
    <string name="batch_numbering_description">In de getoonde volgorde, als track N van %1$d</string>
    <string name="batch_numbering_start">Beginnen bij</string>
    <string name="batch_pattern">Tags uit bestandsnamen lezen</string>
    <!-- The placeholders in braces are typed as they are: don't translate them -->
    <string name="batch_pattern_description">Gebruik {title}, {artist}, {album}, {albumartist}, {track}, {disc}, {year} en {genre}</string>
    <string name="batch_pattern_field">Patroon</string>
    <string name="batch_pattern_invalid">Gebruik elke plaatshouder één keer, en ten minste één</string>
    <string name="batch_pattern_no_match">Komt niet overeen</string>

    <!-- Applying -->
    <string name="batch_apply">Op alle toepassen</string>
    <string name="batch_access_denied">Metadator mocht deze bestanden niet wijzigen</string>
    <string name="batch_running">%1$d van %2$d opslaan</string>
    <string name="batch_cancel">Stoppen</string>

    <!-- Result -->
    <string name="batch_done_title">Klaar</string>
    <plurals name="batch_saved">
        <item quantity="one">%1$d nummer opgeslagen</item>
        <item quantity="other">%1$d nummers opgeslagen</item>
    </plurals>
    <plurals name="batch_failed">
        <item quantity="one">%1$d nummer kon niet worden opgeslagen</item>
        <item quantity="other">%1$d nummers konden niet worden opgeslagen</item>
    </plurals>
    <plurals name="batch_undone">
        <item quantity="one">%1$d nummer hersteld</item>
        <item quantity="other">%1$d nummers hersteld</item>
    </plurals>
    <string name="batch_cancelled">Gestopt. De nummers die al zijn opgeslagen, behouden hun wijzigingen.</string>
    <string name="batch_undo_all">Alles ongedaan maken</string>
    <string name="batch_finish">Voltooien</string>
    <!-- Why a song couldn't be saved, shown next to its title -->
    <string name="batch_reason_access">niet toegestaan</string>
    <string name="batch_reason_gone">bestand is er niet meer</string>
    <string name="batch_reason_unsupported">formaat niet ondersteund</string>
    <string name="batch_reason_failed">schrijven mislukt</string>
</resources>
