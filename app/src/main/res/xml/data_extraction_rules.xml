<?xml version="1.0" encoding="utf-8"?>
<!-- Settings travel with a backup; undo history is about files on this device, so it stays. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="metadator.db" />
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="metadator.db" />
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
